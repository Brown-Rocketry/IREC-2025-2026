with "config/terrarium_pico_config.gpr";
with "pico_bsp.gpr";

project Terrarium_Pico is
   for Target use "arm-eabi";
   for Runtime ("Ada") use "light-cortex-m0p";

   package Linker is
      for Switches ("Ada") use pico_bsp.linker_switches;
   end Linker;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Terrarium_Pico_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ( "spi_flash_test.adb");

   package Compiler is
      for Default_Switches ("Ada") use Terrarium_Pico_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end Terrarium_Pico;