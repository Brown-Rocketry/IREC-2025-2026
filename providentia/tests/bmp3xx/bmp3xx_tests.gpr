--  Host tests for the bmp3xx chip crate. Native build, no board.
--     cd tests/bmp3xx && ./run.sh

project BMP3XX_Tests is

   for Source_Dirs use
     ("src",
      "../../src/chips/bmp3xx",
      "../../src/generics/baro_generic",
      "../../alire/cache/pins/i2c_generic/src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("bmp3xx_tests.adb");

   package Compiler is
      --  -gnata turns on Pre/Post and Assert, -gnato13 checks overflow
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnato13", "-g", "-gnatwa", "-gnatw.X", "-gnatwJ");
   end Compiler;

end BMP3XX_Tests;
