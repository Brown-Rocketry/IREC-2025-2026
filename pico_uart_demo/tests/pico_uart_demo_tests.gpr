with "config/pico_uart_demo_tests_config.gpr";
with "config/pico_uart_demo_tests_list_config.gpr";

project Pico_Uart_Demo_Tests is
   for Source_Dirs use ("src/**", "common/", "config/");
   for Object_Dir use "obj/" & Pico_Uart_Demo_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use Pico_Uart_Demo_Tests_List_Config.Test_Files;

   package Compiler is
      for Default_Switches ("Ada") use
        Pico_Uart_Demo_Tests_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;
end Pico_Uart_Demo_Tests;
