with "config/pico_uart_demo_config.gpr";
with "pico_bsp.gpr"; -- important

project Pico_Uart_Demo is

   -- important 2
   for Target use "arm-eabi";
   for Runtime ("Ada") use "light-cortex-m0p";

   -- important 3
   package Linker is
      for Switches ("Ada") use pico_bsp.linker_switches;
   end Linker;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Pico_Uart_Demo_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   --auto changes with alr build, remember binary name
   for Main use ("pico_uart_demo.adb"); 

   package Compiler is
      for Default_Switches ("Ada") use Pico_Uart_Demo_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Pico_Uart_Demo;